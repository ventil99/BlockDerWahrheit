@page "/"

<PageTitle>Wizard-Punktezähler</PageTitle>

<main class="app-shell">
    <header class="masthead">
        <div class="brand-mark" aria-hidden="true">W</div>
        <div>
            <p class="eyebrow">Der Punktezähler für eure Runde</p>
            <h1>Wizard</h1>
        </div>
        <span class="edition-tag">30 Jahre</span>
    </header>

    <section class="game-card" aria-labelledby="page-heading">
        @if (phase == GamePhase.Setup)
        {
            <div class="section-heading">
                <div>
                    <p class="step-label">Schritt 1 von 3</p>
                    <h2 id="page-heading">Wer spielt mit?</h2>
                    <p class="muted">Namen in Sitzreihenfolge im Uhrzeigersinn eintragen.</p>
                </div>
                <span class="round-pill">3–6 Spielende</span>
            </div>

            <div class="player-list">
                @for (var i = 0; i < players.Count; i++)
                {
                    var index = i;
                    var player = players[index];
                    <div class="player-row" @key="player">
                        <span class="seat-number" aria-hidden="true">@(index + 1)</span>
                        <div class="field">
                            <label for="player-name-@index">Name für Spielende @(index + 1)</label>
                            <input id="player-name-@index" @bind="player.Name" @bind:event="oninput" autocomplete="off" placeholder="Name eingeben" />
                        </div>
                        <button class="icon-button" type="button" aria-label="Spielende @(index + 1) entfernen" @onclick="() => RemovePlayer(index)">×</button>
                    </div>
                }
            </div>

            <button class="secondary-button add-button" type="button" @onclick="AddPlayer" disabled="@(players.Count >= MaxPlayers)">
                <span aria-hidden="true">＋</span> Spielende hinzufügen
            </button>

            @if (!string.IsNullOrWhiteSpace(setupError))
            {
                <p class="form-error" role="alert">@setupError</p>
            }

            <div class="setup-settings">
                <fieldset class="setup-group">
                    <legend>Regel für die Vorhersagesumme</legend>
                    <label class="setting-option">
                        <input type="radio" name="prediction-sum-rule" checked="@(!mustPredictionSumDiffer)" @onchange="() => mustPredictionSumDiffer = false" />
                        <span>Vorhersagesumme darf der Stichzahl entsprechen <strong>(Standard)</strong></span>
                    </label>
                    <label class="setting-option">
                        <input type="radio" name="prediction-sum-rule" checked="@mustPredictionSumDiffer" @onchange="() => mustPredictionSumDiffer = true" />
                        <span>Vorhersagesumme muss von der Stichzahl abweichen</span>
                    </label>
                </fieldset>

                <fieldset class="setup-group">
                    <legend>Sonderkarten dieser Partie</legend>
                    <p class="muted">Wählt die Karten aus, die ihr verwendet. Auch keine Sonderkarten sind möglich.</p>
                    <div class="special-card-options">
                        @foreach (var card in SpecialCardNames)
                        {
                            <label class="card-option">
                                <input type="checkbox" @bind="selectedSpecialCards[card]" />
                                <span>@card</span>
                            </label>
                        }
                    </div>
                    <p class="special-card-note">Drache und Fee werden gemeinsam empfohlen.</p>
                </fieldset>
            </div>

            <button class="primary-button" type="button" @onclick="StartGame">Partie starten <span aria-hidden="true">→</span></button>
        }
        else if (phase == GamePhase.Predictions)
        {
            <div class="section-heading">
                <div>
                    <p class="step-label">Schritt 2 von 3 · Stichrunde @CurrentRoundNumber von @MaximumRounds</p>
                    <h2 id="page-heading">Vorhersagen</h2>
                    <p class="muted">Jede Person sagt vor Beginn @RoundTrickCount @(RoundTrickCount == 1 ? "Stich" : "Stiche") voraus.</p>
                </div>
                <span class="round-pill">@RoundTrickCount @(RoundTrickCount == 1 ? "Stich" : "Stiche")</span>
            </div>

            <div class="turn-order" aria-label="Reihenfolge der Vorhersagen">
                <div class="turn-item"><span class="turn-icon" aria-hidden="true">♛</span><p><span>Geber</span><strong>@players[dealerIndex].Name</strong></p></div>
                <div class="turn-item"><span class="turn-icon" aria-hidden="true">↻</span><p><span>Vorhersage beginnt bei</span><strong>@players[FirstPredictorIndex].Name</strong></p></div>
                <div class="turn-item"><span class="turn-icon" aria-hidden="true">♠</span><p><span>Erster Stich beginnt bei</span><strong>@players[FirstPredictorIndex].Name</strong></p></div>
            </div>

            <div class="prediction-list">
                @foreach (var entry in PredictionOrder.Select((player, index) => (player, index)))
                {
                    <div class="entry-row" @key="entry.player">
                        <span class="seat-number" aria-hidden="true">@(entry.index + 1)</span>
                        <label for="prediction-@entry.index">@entry.player.Name</label>
                        <div class="number-field"><input id="prediction-@entry.index" type="number" min="0" max="@RoundTrickCount" step="1" @bind="entry.player.Prediction" @bind:event="oninput" inputmode="numeric" /><span>Stiche</span></div>
                    </div>
                }
            </div>

            <p class="sum-note">Vorhersagesumme: <strong>@PredictionSum</strong> von @RoundTrickCount @(RoundTrickCount == 1 ? "Stich" : "Stichen"). Die Summe @PredictionSumRule</p>
            @if (!string.IsNullOrWhiteSpace(predictionError))
            {
                <p class="form-error" role="alert">@predictionError</p>
            }
            <button class="primary-button" type="button" @onclick="StartRound">Vorhersagen bestätigen <span aria-hidden="true">→</span></button>
        }
        else if (phase == GamePhase.Scoring)
        {
            <div class="section-heading">
                <div>
                    <p class="step-label">Schritt 3 von 3 · Stichrunde @CurrentRoundNumber von @MaximumRounds</p>
                    <h2 id="page-heading">Gewonnene Stiche</h2>
                    <p class="muted">Tragt ein, wer die @RoundTrickCount @(RoundTrickCount == 1 ? "Stich" : "Stiche") gewonnen hat.</p>
                </div>
                <span class="round-pill">@RoundTrickCount @(RoundTrickCount == 1 ? "Stich" : "Stiche")</span>
            </div>

            @if (selectedSpecialCards["Bombe"] || selectedSpecialCards["Wolke"])
            {
                <fieldset class="setup-group bomb-capture">
                    <legend>Sonderkarten erfassen</legend>
                    @if (selectedSpecialCards["Bombe"])
                    {
                        <button class="secondary-button bomb-add-button" type="button" aria-label="Bombe hinzufügen" disabled="@(!CanRecordBomb)" @onclick="RecordBomb"><span aria-hidden="true">+</span> Bombe hinzufügen</button>
                        <p class="sum-note">Bomben ausgespielt: <strong>@bombCount von @MaxUsesPerCard</strong></p>
                    }
                    @if (selectedSpecialCards["Wolke"])
                    {
                        <button class="secondary-button bomb-add-button" type="button" aria-label="Wolke hinzufügen" disabled="@(!CanRecordCloud)" @onclick="OpenCloudDialog"><span aria-hidden="true">+</span> Wolke hinzufügen</button>
                        <p class="sum-note">Wolken ausgespielt: <strong>@CloudCount von @MaxUsesPerCard</strong></p>
                    }
                    <p class="sum-note">Sonderkarten-Einsätze: <strong>@SpecialCardUseCount von @MaxRoundSpecialUses</strong> in dieser Stichrunde.</p>
                </fieldset>
            }

            <div class="prediction-list">
                @foreach (var entry in PredictionOrder.Select((player, index) => (player, index)))
                {
                    <div class="entry-row" @key="entry.player">
                        <span class="seat-number" aria-hidden="true">@(entry.index + 1)</span>
                        <div class="score-name"><strong>@entry.player.Name</strong><span>Vorhersage: @entry.player.Prediction</span></div>
                        <div class="number-field"><input id="won-@entry.index" aria-label="Gewonnene Stiche für @entry.player.Name" type="number" min="0" max="@RoundTrickCount" step="1" @bind="entry.player.WonTricks" @bind:event="oninput" inputmode="numeric" /><span>Stiche</span></div>
                    </div>
                }
            </div>

            <p class="sum-note">Gewonnene Stiche: <strong>@WonTrickSum</strong> von @DistributableTrickCount.</p>
            @if (!string.IsNullOrWhiteSpace(scoringError))
            {
                <p class="form-error" role="alert">@scoringError</p>
            }
            <button class="primary-button" type="button" @onclick="FinishRound">Wertung berechnen <span aria-hidden="true">→</span></button>
        }
        else
        {
            <div class="section-heading result-heading">
                <div>
                    <p class="step-label">@(endedEarly ? "Partie vorzeitig beendet" : GameComplete ? "Partie abgeschlossen" : $"Stichrunde {completedRounds.Count} abgeschlossen")</p>
                    <h2 id="page-heading">Euer Ergebnis</h2>
                    <p class="muted">Rundenpunkte und Gesamtpunkte dieser Partie.</p>
                </div>
                <span class="success-mark" aria-label="Abgeschlossen">✓</span>
            </div>

            @if (GameComplete)
            {
                <p class="sum-note">@(endedEarly ? $"Der gewertete Endstand nach Stichrunde {completedRounds.Count} bleibt erhalten." : "Alle regulären Stichrunden sind abgeschlossen.")</p>
            }
            else
            {
                <button class="primary-button" type="button" @onclick="StartNextRound">Stichrunde @CurrentRoundNumber starten <span aria-hidden="true">→</span></button>
                <button class="secondary-button end-early-button" type="button" @onclick="EndGameEarly">Partie vorzeitig beenden</button>
            }

            <div class="scoring-note"><strong>Wertung</strong><span>Exakte Vorhersage: 20 Punkte plus 10 je Stich. Sonst: −10 Punkte je Stich Abweichung.</span></div>
        }

        @if (phase != GamePhase.Setup)
        {
            <section class="game-settings" aria-label="Vereinbarte Einstellungen">
                <h3>Vereinbarte Einstellungen</h3>
                <p>Vorhersagesumme @PredictionSumRule</p>
                <p>Sonderkarten: @SpecialCardsSummary</p>
            </section>
        }

        @if (completedRounds.Count > 0)
        {
            <details class="round-history" open="@(phase == GamePhase.Results)">
                <summary>Bisherige Ergebnisse (@completedRounds.Count @(completedRounds.Count == 1 ? "Stichrunde" : "Stichrunden"))</summary>
                @foreach (var round in completedRounds)
                {
                    <div class="round-result">
                        <h3>Stichrunde @round.Number <span>Geber: @players[round.DealerIndex].Name</span></h3>
                        @if (round.BombCount > 0)
                        {
                            <p class="muted">Ausgespielte Bomben: @round.BombCount</p>
                        }
                        @if (round.CloudEvents.Count > 0)
                        {
                            <p class="muted">Wolkenereignisse: @string.Join("; ", round.CloudEvents.Select(cloud => cloud.Bombed ? "Bombe + Wolke: keine Änderung" : players[cloud.PlayerIndex!.Value].Name + ": " + Signed(cloud.Change)))</p>
                        }
                        <div class="results-table-wrap">
                            <table>
                                <thead><tr><th scope="col">Person</th><th scope="col">Ursprüngliche Vorhersage</th><th scope="col">Wolke</th><th scope="col">Gültige Vorhersage</th><th scope="col">Stiche</th><th scope="col">Runde</th><th scope="col">Gesamt</th></tr></thead>
                                <tbody>
                                    @foreach (var result in round.Results)
                                    {
                                        <tr>
                                            <th scope="row">@result.Player.Name</th>
                                            <td>@result.OriginalPrediction</td>
                                            <td>@Signed(result.CloudChange)</td>
                                            <td>@result.Prediction</td>
                                            <td>@result.WonTricks</td>
                                            <td class="points">@Signed(result.Points)</td>
                                            <td class="points total-points">@Signed(result.TotalPoints)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </details>
        }

        @if (showCloudDialog)
        {
            <div class="dialog-backdrop" role="presentation" @onclick="CloseCloudDialog">
                <section class="cloud-dialog" role="dialog" aria-modal="true" aria-labelledby="cloud-dialog-title" tabindex="-1" @onclick:stopPropagation="true" @onkeydown="HandleCloudDialogKeyDown">
                    <h2 id="cloud-dialog-title">Wolkenstich erfassen</h2>
                    <label class="setting-option">
                        <input type="checkbox" @bind="cloudOnBombedTrick" autofocus />
                        <span>In diesem Stich wurde auch eine Bombe gespielt</span>
                    </label>
                    @if (cloudOnBombedTrick)
                    {
                        <p class="muted">Bei Bombe und Wolke im selben Stich bleibt die Vorhersage unverändert.</p>
                    }
                    else
                    {
                        <div class="field">
                            <label for="cloud-player">Gewinnende Person</label>
                            <select id="cloud-player" @bind="cloudPlayerIndex">
                                @for (var index = 0; index < players.Count; index++)
                                {
                                    <option value="@index">@players[index].Name (Vorhersage @players[index].Prediction)</option>
                                }
                            </select>
                        </div>
                        <fieldset class="setup-group">
                            <legend>Vorhersage ändern</legend>
                            <label class="setting-option"><input type="radio" name="cloud-change" checked="@(cloudChange == -1)" @onchange="() => cloudChange = -1" /> <span>Vorhersage um eins verringern (−1)</span></label>
                            <label class="setting-option"><input type="radio" name="cloud-change" checked="@(cloudChange == 1)" @onchange="() => cloudChange = 1" /> <span>Vorhersage um eins erhöhen (+1)</span></label>
                        </fieldset>
                    }
                    @if (!string.IsNullOrWhiteSpace(cloudError))
                    {
                        <p class="form-error" role="alert">@cloudError</p>
                    }
                    <div class="dialog-actions">
                        <button class="secondary-button" type="button" @onclick="CloseCloudDialog">Abbrechen</button>
                        <button class="primary-button" type="button" @onclick="ApplyCloud">Wolke erfassen</button>
                    </div>
                </section>
            </div>
        }
    </section>

    <footer class="app-footer">Punkte im Blick. Spielspaß am Tisch.</footer>
</main>

@code {
    private const int MinPlayers = 3;
    private const int MaxPlayers = 6;
    private static readonly string[] SpecialCardNames = ["Gestaltenwandler", "Drache", "Fee", "Bombe", "Werwolf", "Jongleur", "Wolke", "Hexe", "Vampir"];
    private readonly List<Participant> players = [new(), new(), new()];
    private readonly List<CompletedRound> completedRounds = [];
    private readonly List<CloudEvent> cloudEvents = [];
    private int bombCount;
    private bool showCloudDialog;
    private bool cloudOnBombedTrick;
    private int cloudPlayerIndex;
    private int cloudChange = 1;
    private string cloudError = "";
    private readonly Dictionary<string, bool> selectedSpecialCards = SpecialCardNames.ToDictionary(card => card, _ => true);
    private GamePhase phase = GamePhase.Setup;
    private int dealerIndex;
    private bool endedEarly;
    private bool mustPredictionSumDiffer;
    private string setupError = "";
    private string predictionError = "";
    private string scoringError = "";

    private int CurrentRoundNumber => completedRounds.Count + 1;
    private int MaximumRounds => 60 / players.Count;
    private bool GameComplete => endedEarly || completedRounds.Count == MaximumRounds;
    private int RoundTrickCount => CurrentRoundNumber;
    private int FirstPredictorIndex => (dealerIndex + 1) % players.Count;
    private IEnumerable<Participant> PredictionOrder => Enumerable.Range(1, players.Count).Select(offset => players[(dealerIndex + offset) % players.Count]);
    private int PredictionSum => players.Sum(player => player.Prediction ?? 0);
    private int WonTrickSum => players.Sum(player => player.WonTricks ?? 0);
    private int DistributableTrickCount => RoundTrickCount - bombCount;
    private int MaxUsesPerCard => selectedSpecialCards["Hexe"] && RoundTrickCount > 1 ? 2 : 1;
    private int MaxRoundSpecialUses => Math.Min(selectedSpecialCards["Hexe"] ? 3 : 2, RoundTrickCount);
    private int CloudCount => cloudEvents.Count;
    private int SpecialCardUseCount => bombCount + CloudCount;
    private bool CanRecordBomb => bombCount < MaxUsesPerCard && SpecialCardUseCount < MaxRoundSpecialUses;
    private bool CanRecordCloud => CloudCount < MaxUsesPerCard && SpecialCardUseCount < MaxRoundSpecialUses;
    private string PredictionSumRule => mustPredictionSumDiffer ? "muss von der Stichzahl abweichen." : "darf der Stichzahl entsprechen.";
    private string SpecialCardsSummary
    {
        get
        {
            var selected = SpecialCardNames.Where(card => selectedSpecialCards[card]).ToArray();
            return selected.Length == 0 ? "keine Sonderkarten" : string.Join(", ", selected);
        }
    }

    private void AddPlayer()
    {
        if (players.Count < MaxPlayers)
            players.Add(new Participant());
    }

    private void RemovePlayer(int index)
    {
        players.RemoveAt(index);
    }

    private void StartGame()
    {
        setupError = "";
        if (players.Count is < MinPlayers or > MaxPlayers)
        {
            setupError = "Für eine Wizard-Partie braucht ihr drei bis sechs Spielende.";
            return;
        }

        if (players.Any(player => string.IsNullOrWhiteSpace(player.Name)))
        {
            setupError = "Bitte tragt für alle Personen einen Namen ein.";
            return;
        }

        foreach (var player in players)
            player.Name = player.Name.Trim();

        dealerIndex = Random.Shared.Next(players.Count);
        phase = GamePhase.Predictions;
    }

    private void StartRound()
    {
        predictionError = "";
        if (players.Any(player => player.Prediction is null || player.Prediction < 0 || player.Prediction > RoundTrickCount))
        {
            predictionError = $"Jede Vorhersage muss eine ganze Zahl von 0 bis {RoundTrickCount} sein.";
            return;
        }

        if (mustPredictionSumDiffer && PredictionSum == RoundTrickCount)
        {
            predictionError = $"Die Vorhersagesumme muss von der Stichzahl ({RoundTrickCount}) abweichen.";
            return;
        }

        foreach (var player in players)
            player.OriginalPrediction = player.Prediction;

        bombCount = 0;
        cloudEvents.Clear();
        phase = GamePhase.Scoring;
    }

    private void RecordBomb()
    {
        if (phase == GamePhase.Scoring && selectedSpecialCards["Bombe"] && CanRecordBomb)
            bombCount++;
    }

    private void OpenCloudDialog()
    {
        if (phase != GamePhase.Scoring || !selectedSpecialCards["Wolke"] || !CanRecordCloud)
            return;

        cloudPlayerIndex = FirstPredictorIndex;
        cloudChange = 1;
        cloudOnBombedTrick = false;
        cloudError = "";
        showCloudDialog = true;
    }

    private void ApplyCloud()
    {
        cloudError = "";
        if (phase != GamePhase.Scoring || !selectedSpecialCards["Wolke"] || !CanRecordCloud)
            return;

        if (cloudOnBombedTrick)
        {
            cloudEvents.Add(new CloudEvent(null, 0, true));
        }
        else
        {
            if (cloudPlayerIndex < 0 || cloudPlayerIndex >= players.Count || cloudChange is not (-1 or 1))
            {
                cloudError = "Bitte wählt eine gewinnende Person und eine Änderung um eins.";
                return;
            }

            var player = players[cloudPlayerIndex];
            var changedPrediction = player.Prediction!.Value + cloudChange;
            if (changedPrediction < 0 || changedPrediction > RoundTrickCount)
            {
                cloudError = $"Die gültige Vorhersage muss zwischen 0 und {RoundTrickCount} liegen.";
                return;
            }

            player.Prediction = changedPrediction;
            cloudEvents.Add(new CloudEvent(cloudPlayerIndex, cloudChange, false));
        }

        showCloudDialog = false;
    }

    private void CloseCloudDialog()
    {
        showCloudDialog = false;
        cloudError = "";
    }

    private void HandleCloudDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            CloseCloudDialog();
    }

    private void FinishRound()
    {
        scoringError = "";
        if (cloudEvents.Count(cloud => cloud.Bombed) > bombCount)
        {
            scoringError = "Erfasst für jede Wolke im Bombenstich auch eine Bombe.";
            return;
        }

        if (players.Any(player => player.WonTricks is null || player.WonTricks < 0 || player.WonTricks > RoundTrickCount))
        {
            scoringError = $"Die gewonnenen Stiche müssen je Person zwischen 0 und {RoundTrickCount} liegen.";
            return;
        }

        if (WonTrickSum != DistributableTrickCount)
        {
            scoringError = $"Die Summe der gewonnenen Stiche muss genau {DistributableTrickCount} betragen.";
            return;
        }

        var results = players.Select(player =>
        {
            var prediction = player.Prediction!.Value;
            var originalPrediction = player.OriginalPrediction!.Value;
            var wonTricks = player.WonTricks!.Value;
            var difference = Math.Abs(prediction - wonTricks);
            var points = difference == 0 ? 20 + 10 * wonTricks : -10 * difference;
            player.TotalPoints += points;
            var cloudChange = cloudEvents.Where(cloud => !cloud.Bombed && cloud.PlayerIndex == players.IndexOf(player)).Sum(cloud => cloud.Change);
            return new RoundPlayerResult(player, originalPrediction, cloudChange, prediction, wonTricks, points, player.TotalPoints);
        }).ToList();

        completedRounds.Add(new CompletedRound(CurrentRoundNumber, dealerIndex, results, bombCount, cloudEvents.ToList()));
        phase = GamePhase.Results;
    }

    private void StartNextRound()
    {
        if (phase != GamePhase.Results || GameComplete)
            return;

        dealerIndex = (dealerIndex + 1) % players.Count;
        foreach (var player in players)
        {
            player.Prediction = null;
            player.OriginalPrediction = null;
            player.WonTricks = null;
        }

        bombCount = 0;
        cloudEvents.Clear();
        predictionError = "";
        scoringError = "";
        phase = GamePhase.Predictions;
    }

    private void EndGameEarly()
    {
        if (phase == GamePhase.Results && !GameComplete)
            endedEarly = true;
    }

    private static string Signed(int points) => points > 0 ? $"+{points}" : points.ToString();
    private sealed class Participant
    {
        public string Name { get; set; } = "";
        public int? Prediction { get; set; }
        public int? OriginalPrediction { get; set; }
        public int? WonTricks { get; set; }
        public int TotalPoints { get; set; }
    }

    private sealed record CompletedRound(int Number, int DealerIndex, List<RoundPlayerResult> Results, int BombCount, List<CloudEvent> CloudEvents);
    private sealed record CloudEvent(int? PlayerIndex, int Change, bool Bombed);
    private sealed record RoundPlayerResult(Participant Player, int OriginalPrediction, int CloudChange, int Prediction, int WonTricks, int Points, int TotalPoints);

    private enum GamePhase { Setup, Predictions, Scoring, Results }
}
